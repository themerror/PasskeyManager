<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="PasskeyManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PasskeyManager"
    xmlns:views="using:PasskeyManager.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Other merged dictionaries here  -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                Semantic design tokens for the Passkey Manager workspace.
                All colors come from theme resources so light / dark / high-contrast
                themes are handled automatically.
            -->
            <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AppPillCornerRadius">8</CornerRadius>
            <Thickness x:Key="AppCardPadding">20,16</Thickness>
            <Thickness x:Key="AppSectionPadding">24,20,24,12</Thickness>
            <x:Double x:Key="AppIconHostSize">38</x:Double>
            <x:Double x:Key="AppAvatarSize">40</x:Double>
            <views:StatusSeverityConverter x:Key="StatusSeverityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
