<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PasskeyManager.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PasskeyManager.Views"
    xmlns:models="using:PasskeyManager.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="RootNavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="232"
            PaneDisplayMode="Left"
            SelectionChanged="NavigationView_SelectionChanged">

            <NavigationView.Header>
                <Grid Padding="16,10,16,0">
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">

                        <!-- Plugin identity indicator -->
                        <Border
                            x:Uid="PluginIdentityBadge"
                            VerticalAlignment="Center"
                            Padding="10,4"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="{StaticResource AppPillCornerRadius}"
                            ToolTipService.ToolTip="纯 C# WebAuthn 插件；使用真实 CNG 密钥与 Windows Hello">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    x:Uid="PluginIdentityLabel"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="C# 插件" />
                            </StackPanel>
                        </Border>

                        <!-- Vault lock / unlock, shared by overview & settings as well -->
                        <Button
                            x:Name="VaultButton"
                            x:Uid="VaultButton"
                            AutomationProperties.AutomationId="VaultButton"
                            AutomationProperties.Name="锁定或解锁保险库"
                            Click="VaultButton_Click"
                            ToolTipService.ToolTip="锁定或解锁保险库">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Grid Width="16" Height="16">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Glyph="&#xE72E;"
                                        Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.IsVaultUnlocked), Mode=OneWay}" />
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Glyph="&#xE785;"
                                        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsVaultUnlocked), Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.VaultStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Uid="NavOverview"
                    AutomationProperties.AutomationId="NavOverview"
                    AutomationProperties.Name="概览"
                    Content="概览"
                    Tag="Overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavPasskeys"
                    AutomationProperties.AutomationId="NavPasskeys"
                    AutomationProperties.Name="通行密钥"
                    Content="通行密钥"
                    Tag="Passkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavActivity"
                    AutomationProperties.AutomationId="NavActivity"
                    AutomationProperties.Name="活动"
                    Content="活动"
                    Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Uid="NavSettings"
                    AutomationProperties.AutomationId="NavSettings"
                    AutomationProperties.Name="设置"
                    Content="设置"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" />
            </NavigationView.Content>
        </NavigationView>

        <InfoBar
            x:Name="StatusInfoBar"
            x:Uid="StatusInfoBar"
            Grid.Row="1"
            Margin="12,0,12,12"
            AutomationProperties.Name="操作状态"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource StatusSeverityConverter}}"
            Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
    </Grid>
</Page>
