<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PasskeyManager.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PasskeyManager.Views"
    xmlns:models="using:PasskeyManager.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="{StaticResource AppSectionPadding}">
        <StackPanel MaxWidth="1100" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock x:Uid="OverviewTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="概览" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.TotalSummary, Mode=OneWay}" />
            </StackPanel>

            <!-- Stat cards -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="StatCol1" Width="*" />
                    <ColumnDefinition x:Name="StatCol2" Width="*" />
                    <ColumnDefinition x:Name="StatCol3" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="NarrowStats">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="StatCol2.Width" Value="0" />
                                <Setter Target="StatCol3.Width" Value="0" />
                                <Setter Target="StatCard2.(Grid.Row)" Value="1" />
                                <Setter Target="StatCard3.(Grid.Row)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="WideStats">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Border
                    x:Name="StatCard1"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="{StaticResource AppCardPadding}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppCardCornerRadius}">
                    <StackPanel Spacing="10">
                        <Grid
                            Width="{StaticResource AppIconHostSize}"
                            Height="{StaticResource AppIconHostSize}">
                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE963;" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="StatLocalLabel"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="本地凭据" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.LocalCount, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="StatCard2"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="{StaticResource AppCardPadding}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppCardCornerRadius}">
                    <StackPanel Spacing="10">
                        <Grid
                            Width="{StaticResource AppIconHostSize}"
                            Height="{StaticResource AppIconHostSize}">
                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE928;" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="StatAutofillLabel"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="自动填充" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.AutofillCount, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="StatCard3"
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="{StaticResource AppCardPadding}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppCardCornerRadius}">
                    <StackPanel Spacing="10">
                        <Grid
                            Width="{StaticResource AppIconHostSize}"
                            Height="{StaticResource AppIconHostSize}">
                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE72E;" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="StatVaultLabel"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="保险库状态" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.VaultStatusText, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.VaultSummary, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Browser-initiated WebAuthn tests -->
            <Border
                Padding="{StaticResource AppCardPadding}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppCardCornerRadius}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="RealOpsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="真实 WebAuthn 操作" />
                        <TextBlock
                            x:Uid="RealOpsDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="按钮只打开测试网站；创建与登录必须由网站发起，再由 Windows 调用此插件。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="OverviewNewPasskeyButton"
                            AutomationProperties.AutomationId="OverviewNewPasskeyButton"
                            AutomationProperties.Name="创建测试"
                            Click="NewPasskeyButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock x:Uid="OverviewNewPasskeyLabel" VerticalAlignment="Center" Text="创建测试" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Uid="OverviewSignInButton"
                            AutomationProperties.AutomationId="OverviewSignInButton"
                            AutomationProperties.Name="登录测试"
                            Click="SignInButton_Click">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8AD;" />
                                <TextBlock x:Uid="OverviewSignInLabel" VerticalAlignment="Center" Text="登录测试" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recent activity -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="RecentActivityTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="最近活动" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}">
                        <Run x:Uid="ActivityCountPrefix" Text="共" /><Run Text="{x:Bind ViewModel.ActivityCount, Mode=OneWay}" /><Run x:Uid="ActivityCountSuffix" Text="条" />
                    </TextBlock>
                </StackPanel>
                <Border
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppCardCornerRadius}">
                    <ItemsControl
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Activities, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ActivityEntry">
                                <Grid Padding="16,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind IconGlyph, Mode=OneTime}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Message, Mode=OneTime}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind TimestampDisplay, Mode=OneTime}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Security note -->
            <InfoBar
                x:Uid="SecurityNote"
                IsClosable="False"
                IsOpen="True"
                Message="此应用会注册真实 COM 插件并创建 CNG 私钥。请仅用于测试；启用插件与 Windows Hello 验证均由用户完成。"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
