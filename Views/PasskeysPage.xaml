<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PasskeyManager.Views.PasskeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PasskeyManager.Views"
    xmlns:models="using:PasskeyManager.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PasskeyListColumn" Width="340" />
            <ColumnDefinition x:Name="PasskeyDetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowPasskeys">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PasskeyListColumn.Width" Value="*" />
                        <Setter Target="PasskeyDetailColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WidePasskeys">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Left: list & tools -->
        <Grid Grid.Column="0" Padding="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Uid="PasskeysTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="通行密钥" />
                <TextBlock
                    x:Uid="PasskeysDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="管理此插件创建的真实凭据与 Windows 自动填充缓存。" />
            </StackPanel>

            <TextBox
                x:Name="SearchBox"
                x:Uid="SearchBox"
                Grid.Row="1"
                Margin="0,16,0,0"
                AutomationProperties.Name="搜索通行密钥"
                Header="搜索通行密钥"
                PlaceholderText="按用户名或网站筛选"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="SearchBox_TextChanged" />

            <TextBlock
                Grid.Row="2"
                Margin="0,12,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.CacheSummary, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />

            <Grid Grid.Row="3" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="AddAllToCacheButton"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="AddAllToCacheButton"
                    AutomationProperties.Name="全部加入缓存"
                    Click="AddAllToCacheButton_Click"
                    ToolTipService.ToolTip="将全部本地凭据加入 Windows 自动填充缓存">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock x:Uid="AddAllToCacheLabel" VerticalAlignment="Center" Text="全部加入缓存" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="RemoveAllFromCacheButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="RemoveAllFromCacheButton"
                    AutomationProperties.Name="全部移除"
                    Click="RemoveAllFromCacheButton_Click"
                    ToolTipService.ToolTip="将全部凭据移出 Windows 自动填充缓存">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE738;" />
                        <TextBlock x:Uid="RemoveAllFromCacheLabel" VerticalAlignment="Center" Text="全部移除" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="4">
                <ListView
                    x:Name="PasskeyList"
                    x:Uid="PasskeyList"
                    AutomationProperties.Name="真实凭据列表"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.FilteredCredentials, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedCredential, Mode=TwoWay}"
                    SelectionChanged="PasskeyList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PasskeyCredential">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="{StaticResource AppAvatarSize}"
                                    Height="{StaticResource AppAvatarSize}">
                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="{x:Bind Initials, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind UserName, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind RpName, Mode=OneWay}" />
                                    <Border
                                        Margin="0,2,0,0"
                                        Padding="6,1"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource AppPillCornerRadius}">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind CacheStatusText, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty: no credentials at all -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.HasCredentials), Mode=OneWay}">
                    <FontIcon
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8D7;" />
                    <TextBlock
                        x:Uid="EmptyCredentialsTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="还没有通行密钥" />
                    <TextBlock
                        x:Uid="EmptyCredentialsDescription"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="注册并启用插件后，通过浏览器创建第一条真实凭据。" />
                    <Button
                        x:Uid="EmptyNewPasskeyButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="EmptyNewPasskeyButton"
                        AutomationProperties.Name="创建测试"
                        Click="NewPasskeyButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock x:Uid="EmptyNewPasskeyLabel" VerticalAlignment="Center" Text="创建测试" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Empty: search returned nothing -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4"
                    Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsEmptySearch), Mode=OneWay}">
                    <TextBlock
                        x:Uid="EmptySearchTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="没有匹配的通行密钥" />
                    <TextBlock
                        x:Uid="EmptySearchDescription"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="换个关键词试试。" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Right: selected credential detail -->
        <Grid Grid.Column="1" Padding="12,20,24,20">
            <Grid Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(ViewModel.HasSelectedCredential), Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="320"
                    Spacing="8">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE928;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectionHint, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasSelectedCredential), Mode=OneWay}">
                <Border
                    Padding="24,20"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppCardCornerRadius}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid Width="56" Height="56">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.SelectedCredential.Initials, Mode=OneWay, FallbackValue=''}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedCredential.DisplayName, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedCredential.UserName, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Uid="DetailSiteLabel"
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="网站" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.SelectedCredential.RpName, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedCredential.RpId, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>

                            <TextBlock
                                x:Uid="DetailCredentialIdLabel"
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="凭据 ID" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedCredential.CredentialIdDisplay, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Uid="DetailCreatedLabel"
                                Grid.Row="2"
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="创建时间" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedCredential.CreatedAtDisplay, Mode=OneWay, FallbackValue=''}" />

                            <TextBlock
                                x:Uid="DetailStorageLabel"
                                Grid.Row="3"
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="存储位置" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedCredential.StorageDescription, Mode=OneWay, FallbackValue=''}" />

                            <TextBlock
                                x:Uid="DetailKeyNameLabel"
                                Grid.Row="4"
                                Grid.Column="0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="CNG 密钥名称" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedCredential.KeyName, Mode=OneWay, FallbackValue=''}" />
                        </Grid>

                        <Border
                            Height="1"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource AppPillCornerRadius}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SelectedCredential.CacheStatusText, Mode=OneWay, FallbackValue=''}" />
                            </Border>
                            <Button
                                x:Uid="ToggleAutofillButton"
                                AutomationProperties.AutomationId="ToggleAutofillButton"
                                AutomationProperties.Name="切换自动填充"
                                Click="ToggleAutofillButton_Click"
                                ToolTipService.ToolTip="在 Windows 自动填充缓存中添加或移除此凭据">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                    <TextBlock x:Uid="ToggleAutofillLabel" VerticalAlignment="Center" Text="切换自动填充" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Uid="SelectedSignInButton"
                                AutomationProperties.AutomationId="SelectedSignInButton"
                                AutomationProperties.Name="登录测试"
                                Click="SignInButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8AD;" />
                                    <TextBlock x:Uid="SelectedSignInLabel" VerticalAlignment="Center" Text="登录测试" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Uid="DeletePasskeyButton"
                                AutomationProperties.AutomationId="DeletePasskeyButton"
                                AutomationProperties.Name="删除此通行密钥"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                Click="DeletePasskeyButton_Click"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                ToolTipService.ToolTip="删除此真实通行密钥及其 CNG 私钥">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    <TextBlock x:Uid="DeletePasskeyLabel" VerticalAlignment="Center" Text="删除" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
